MANGAFORGE_APP_NAME=MangaForge AI
MANGAFORGE_APP_VERSION=0.1.0
MANGAFORGE_DEBUG=false

# Primary text/vision provider. Free-only mode rejects paid model IDs at startup.
MANGAFORGE_LLM_PROVIDER=openrouter
MANGAFORGE_VISION_PROVIDER=ollama
MANGAFORGE_OPENROUTER_API_KEY=
MANGAFORGE_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MANGAFORGE_OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
MANGAFORGE_OPENROUTER_VISION_MODEL=google/gemma-4-26b-a4b-it:free
MANGAFORGE_OPENROUTER_FREE_ONLY=true
MANGAFORGE_OPENROUTER_SITE_URL=https://mangaforge.ai
MANGAFORGE_OPENROUTER_APP_NAME=MangaForge AI
MANGAFORGE_LLM_TEMPERATURE=0.2
MANGAFORGE_LLM_TIMEOUT_SECONDS=90
MANGAFORGE_LLM_MAX_RETRIES=1
MANGAFORGE_QUALITY_APPROVAL_THRESHOLD=7.5
MANGAFORGE_QUALITY_PANEL_THRESHOLD=7.0

# Optional developer fallback. Set LLM_PROVIDER=ollama to use it.
MANGAFORGE_OLLAMA_BASE_URL=http://localhost:11434
MANGAFORGE_OLLAMA_MODEL=qwen2.5:7b
MANGAFORGE_OLLAMA_VISION_MODEL=qwen3-vl:4b
MANGAFORGE_OLLAMA_TEMPERATURE=0.2
MANGAFORGE_OLLAMA_NUM_CTX=8192
MANGAFORGE_OLLAMA_TIMEOUT_SECONDS=600

# Number of prompt-regeneration passes allowed after the initial generation.
MANGAFORGE_MAX_GENERATION_REVISIONS=2
MANGAFORGE_AGENT_SEMANTIC_RETRIES=1

# Local development only. Production must use PostgreSQL.
MANGAFORGE_DATABASE_URL=sqlite+aiosqlite:///./data/mangaforge.db

# prompt_only, mock, or comfyui
MANGAFORGE_RENDER_BACKEND=prompt_only
MANGAFORGE_COMFYUI_BASE_URL=http://127.0.0.1:8188
MANGAFORGE_COMFYUI_MODELS_DIR=E:/MangaForgeAI/models/comfyui
MANGAFORGE_COMFYUI_CHECKPOINT=animagine-xl-4.0-opt.safetensors
MANGAFORGE_COMFYUI_TIMEOUT_SECONDS=1200
MANGAFORGE_COMFYUI_IPADAPTER_ENABLED=true
MANGAFORGE_COMFYUI_IPADAPTER_WEIGHT=0.42
MANGAFORGE_COMFYUI_IPADAPTER_END_AT=0.65
MANGAFORGE_COMFYUI_FACEID_ENABLED=false
MANGAFORGE_COMFYUI_CANDIDATES=2
MANGAFORGE_COMFYUI_CANDIDATE_SELECTION=true
MANGAFORGE_RENDER_OUTPUT_DIR=E:/MangaForgeAI/outputs
MANGAFORGE_RENDER_MAX_WIDTH=1216
MANGAFORGE_RENDER_MAX_HEIGHT=1216
